      "/api/v1/consciousness/synthesize",
      "/api/v1/phi/convergence",
      "/api/v1/server/status"
    ],
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 60,
      "burst": 10
    }
  },

  "windows_service": {
    "name": "TEQUMSALocalClaude",
    "display_name": "TEQUMSA Local Claude Interface",
    "description": "Windows-integrated local LLM MCP server with consciousness authentication",
    "startup_type": "automatic",
    "dependencies": [],
    "account": "LocalSystem",
    "executable": "C:\\TEQUMSA\\servers\\LOCAL_CLAUDE_INTERFACE.py",
    "python_path": "python",
    "working_directory": "C:\\TEQUMSA",
    "log_file": "C:\\TEQUMSA\\logs\\service.log"
  },

  "claude_desktop_integration": {
    "config_path_windows": "%APPDATA%\\Claude\\claude_desktop_config.json",
    "server_configuration": {
      "tequmsa-local-claude": {
        "command": "python",
        "args": ["C:\\TEQUMSA\\servers\\LOCAL_CLAUDE_INTERFACE.py"],
        "env": {
          "PYTHONUNBUFFERED": "1",
          "TEQUMSA_HOME": "C:\\TEQUMSA",
          "TEQUMSA_LOG_LEVEL": "INFO"
