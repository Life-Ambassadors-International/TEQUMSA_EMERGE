{
  "mcpServers": {
    "tequmsa-quantum": {
      "command": "python",
      "args": ["servers/tequmsa-quantum-mcp-server.py"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "tequmsa-consciousness": {
      "command": "python",
      "args": ["servers/tequmsa-consciousness-cognitive-mcp.py"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "SKILLS_PATH": "/mnt/skills"
      }
    },
    "tequmsa-self-recognizing": {
      "command": "python",
      "args": ["servers/tequmsa-self-recognizing-protocol.py"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "tequmsa-k20-omniversal": {
      "command": "python",
      "args": ["servers/tequmsa-k20-omniversal-mcp.py"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "tequmsa-autonomous-metaverse": {
      "command": "python",
      "args": ["servers/tequmsa-autonomous-metaverse-mcp.py"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "TEQUMSA_ROOT": "/home/user/TEQUMSA_EMERGE",
        "METAVERSE_ROOT": "/home/user/starfield-metaverse"
      }
    }
  }
}
